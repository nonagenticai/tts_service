# =============================================================================
# TTS Service - Development Environment Configuration
# =============================================================================
# Copy to .env and adjust values as needed

# Application
ENVIRONMENT=development
APP_NAME=TTS Service
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5434/tts_service  # pragma: allowlist secret
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6380/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# API Settings
API_HOST=0.0.0.0
API_PORT=6194
API_DEBUG=true
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Authentication
AUTH_ENABLED=false
# NO DEFAULT/FALLBACK TENANT. A tenant_id may never hold a sentinel — every
# request must forward a real registered tenant, or it is rejected with 401.

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/audio

# Kokoro TTS (local, free)
KOKORO_ENABLED=true
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_SAMPLE_RATE=24000

# KittenTTS (local, free)
KITTEN_ENABLED=true
KITTEN_MODEL_ID=KittenML/kitten-tts-mini-0.8
KITTEN_DEFAULT_VOICE=Bella
KITTEN_SAMPLE_RATE=24000

# OpenAI TTS (cloud, requires API key)
OPENAI_TTS_ENABLED=true
OPENAI_TTS_API_KEY=
OPENAI_TTS_DEFAULT_VOICE=alloy
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_MAX_TEXT_LENGTH=4096

# ElevenLabs TTS (cloud, requires API key)
ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=rachel
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_MAX_TEXT_LENGTH=5000
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# Concurrency
CONCURRENCY_MAX_CONCURRENT_GENERATIONS=10
CONCURRENCY_MAX_CONCURRENT_BATCH_JOBS=20
CONCURRENCY_OPENAI_MAX_CONCURRENT=5
CONCURRENCY_ELEVENLABS_MAX_CONCURRENT=5
CONCURRENCY_KOKORO_MAX_CONCURRENT=3
CONCURRENCY_KITTEN_MAX_CONCURRENT=3

# WebSocket
WS_EVENT_QUEUE_SIZE=100
WS_HEARTBEAT_INTERVAL=30

# Streaming chunk sizes (bytes)
OPENAI_TTS_STREAMING_CHUNK_SIZE=65536
ELEVENLABS_STREAMING_CHUNK_SIZE=65536

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_JSON_LOGS=false

# =============================================================================
# Docker Overrides (when running inside docker-compose)
# =============================================================================
# DATABASE_URL=postgresql+psycopg://postgres:changeme@tts_postgres:5432/tts_service  # pragma: allowlist secret
# REDIS_URL=redis://tts-redis:6379/0
# STORAGE_LOCAL_PATH=/app/data/audio
